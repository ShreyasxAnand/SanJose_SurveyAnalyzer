# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
# No longer read by the app (settings live in config.json) — still ignored so
# a leftover copy from an older checkout, which may hold an old passcode or
# API key, can never be committed.
*.env
.env

# Server settings — holds the admin passcode and this install's measured cost
# calibration. config.example.json is the checked-in template.
/config.json

# Local-first data (uploads, exports, sqlite db) — never commit survey data
/data/

# Loose spreadsheets dropped at the repo root while testing ingest are survey
# data too — the /data/ rule doesn't cover them because they never move there.
/*.xlsx
/*.xls
/*.csv

# Throwaway benchmark/scratch scripts — they hardcode a local dataset id and
# won't run for anyone else.
backend/ab.py

# Node
node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store

