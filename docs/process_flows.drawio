        <mxCell id="t2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Map pass: each chunk gets one model call proposing granular categories with cited evidence" vertex="1">
          <mxGeometry height="70" width="250" x="55" y="180" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Merge passes: exact-name merge, sort into broad themes, dedupe within each theme, then across themes" vertex="1">
          <mxGeometry height="70" width="250" x="55" y="320" as="geometry" />
        </mxCell>
        <mxCell id="t4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Two-level taxonomy (Parent &gt; Child), new versioned run; latest run wins" vertex="1">
          <mxGeometry height="60" width="250" x="55" y="450" as="geometry" />
        </mxCell>
        <mxCell id="t9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Stage 3: every response labeled against it as-is (no approval gate)" vertex="1">
          <mxGeometry height="60" width="250" x="55" y="570" as="geometry" />
        </mxCell>
        <mxCell id="t8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Sub-themes (grandchild layer) induced inside categories with 150+ members; every member sub-coded; auto-review merges duplicates and folds restatements" vertex="1">
          <mxGeometry height="90" width="250" x="55" y="690" as="geometry" />
        </mxCell>
        <mxCell id="t10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Sameness rulings: similar category / sub-theme pairs ruled same idea or distinct, once per taxonomy version (stage 5 section plans read the store)" vertex="1">
          <mxGeometry height="90" width="250" x="55" y="840" as="geometry" />
        </mxCell>
        <mxCell id="te1" edge="1" parent="1" source="t1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="t2" value="all usable responses, split into disjoint chunks (non-answers skipped, nothing sampled away)">
